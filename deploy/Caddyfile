# Caddy runs on the host and owns ports 80/443. Values are supplied through
# Caddy's systemd environment (for example, /etc/caddy/llamatutor.env).

{$LLAMATUTOR_PRODUCTION_DOMAIN} {
	reverse_proxy 127.0.0.1:3100
}

{$LLAMATUTOR_STAGING_DOMAIN} {
	basic_auth {
		{$STAGING_BASIC_AUTH_USER} {$STAGING_BASIC_AUTH_HASH}
	}

	reverse_proxy 127.0.0.1:3101
}

{$LLAMATUTOR_VOICE_PRODUCTION_DOMAIN} {
	@authorized header Authorization "Bearer {$VOICE_WORKER_SHARED_SECRET}"
	handle @authorized {
		handle_path /daily/* {
			reverse_proxy 127.0.0.1:3202
		}
		handle {
			reverse_proxy 127.0.0.1:3200
		}
	}
	respond "Unauthorized" 401
}

{$LLAMATUTOR_VOICE_STAGING_DOMAIN} {
	@authorized header Authorization "Bearer {$VOICE_WORKER_SHARED_SECRET}"
	handle @authorized {
		handle_path /daily/* {
			reverse_proxy 127.0.0.1:3203
		}
		handle {
			reverse_proxy 127.0.0.1:3201
		}
	}
	respond "Unauthorized" 401
}

# During the edge-proxy migration, recreate writebook without host port 80/443,
# expose its Puma port as 127.0.0.1:3080:3000, and preserve its data volume.
{$WRITEBOOK_DOMAIN} {
	reverse_proxy 127.0.0.1:3080
}
