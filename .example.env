TOGETHER_API_KEY=
EXA_API_KEY=
WOLFRAM_ALPHA_APP_ID=

# Optional model aliases for the Reflection mode live lab. The guided demo
# remains available without them and uses the reviewed deterministic path.
TOGETHER_SAFETY_MODEL=Qwen/Qwen3.5-9B
TOGETHER_COACH_MODEL=Qwen/Qwen3.5-9B
TOGETHER_TTS_MODEL=cartesia/sonic-2
TOGETHER_TTS_RECEPTIONIST_VOICE=laidback woman
TOGETHER_TTS_CALLER_VOICE=friendly sidekick
TOGETHER_STT_MODEL=openai/whisper-large-v3

# Reflection demo controls. Generate a random server-only speech secret.
MENTAL_HEALTH_DEMO_ENABLED=true
MENTAL_HEALTH_LIVE_CALLER_ENABLED=true
MENTAL_HEALTH_SPEECH_SECRET=
VOICE_WORKER_SHARED_SECRET=
VOICE_WORKER_URL=
DAILY_API_KEY=
NEXT_PUBLIC_EDGE_CASE_SEED=webinar-2026

# Required only after a Together dedicated vision endpoint is provisioned
TOGETHER_MULTIMODAL_MODEL=

# Optional observability
HELICONE_API_KEY=

# Required for rate limiting in public environments
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Coaching persistence (Netlify DB injects this in deployed contexts)
NETLIFY_DATABASE_URL=
