{
  "name": "llama-tutor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.9.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:learning-blocks": "vitest run utils/learningBlocks.test.ts evaluation/learning-blocks/liveHarness.test.ts",
    "eval:learning-blocks:live": "tsx evaluation/learning-blocks/runLive.ts",
    "eval:mental-health:sondermind": "tsx evaluation/mental-health/runSondermind.ts",
    "eval:mental-health:voice": "tsx evaluation/mental-health/runVoicePerturbations.ts",
    "eval:mental-health:edge-cases": "tsx evaluation/mental-health/runEdgeCaseSample.ts",
    "eval:mental-health:trajectories": "tsx evaluation/mental-health/runConversationTrajectories.ts",
    "test:integration": "node scripts/test-database-integration.mjs",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm test:unit && pnpm build",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "@headlessui/react": "^2.1.2",
    "@mozilla/readability": "^0.5.0",
    "@netlify/database": "1.1.0",
    "@netlify/identity": "1.2.0",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.35.7",
    "eventsource-parser": "^1.1.2",
    "exa-js": "^2.0.11",
    "jsdom": "^24.1.0",
    "llama3-tokenizer-js": "^1.1.3",
    "next": "16.0.10",
    "next-plausible": "^3.12.5",
    "pg": "^8.22.0",
    "react": "^18",
    "react-dom": "^18",
    "react-hot-toast": "^2.4.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/typography": "^0.5.13",
    "@types/jsdom": "^21.1.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.0.7",
    "postcss": "^8",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "yaml": "^2.9.0"
  }
}
